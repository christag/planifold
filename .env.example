# Copy to .env and edit. Every value is optional except APP_SECRET in production.

# Encrypts API keys at rest. Generate: openssl rand -base64 32
APP_SECRET=

# Public address people use to reach Piecewise. Needed for single sign-on and secure cookies.
BASE_URL=http://localhost:3000

# Network
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=false
# SECURE_COOKIES defaults to true when BASE_URL starts with https://

# Storage (SQLite file; back it up by copying the directory)
DATA_DIR=./data
# PLUGINS_DIR=./plugins-extra

# First administrator, created only when the database is empty. Otherwise visit /setup.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# Password sign-in (turn off once single sign-on works)
AUTH_LOCAL=true

# Single sign-on through any OpenID Connect provider (Entra ID, Okta, Google, Keycloak, Authentik…)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid email profile
OIDC_BUTTON_LABEL=Sign in with single sign-on
OIDC_DEFAULT_ROLE=user
# Comma-separated emails that become app administrators on first sign-in
OIDC_ADMIN_EMAILS=

# Single sign-on through SAML 2.0 (written for Okta). Setting any SAML_IDP_* value turns it on; all three are then required.
# Okta: Applications → your SAML app → Sign On → "View SAML setup instructions"
SAML_IDP_SSO_URL=
SAML_IDP_ISSUER=
# PEM certificate on one line with \n between lines, or point SAML_IDP_CERT_FILE at the file
SAML_IDP_CERT=
# SAML_IDP_CERT_FILE=/etc/piecewise/okta.pem
# Defaults to <BASE_URL>/api/auth/saml/metadata; Okta calls it "Audience URI (SP Entity ID)"
SAML_SP_ENTITY_ID=
# Optional key pair for signed requests and encrypted assertions (both or neither)
# SAML_SP_PRIVATE_KEY_FILE=
# SAML_SP_CERT_FILE=
SAML_BUTTON_LABEL=Sign in with SAML single sign-on
SAML_DEFAULT_ROLE=user
# Comma-separated emails that become app administrators when created by SAML or SCIM
SAML_ADMIN_EMAILS=
# Comma-separated group names (from the "groups" attribute) whose members become app administrators
SAML_ADMIN_GROUPS=
# Attribute names to read; these are the Okta attribute statements the docs suggest
SAML_ATTR_EMAIL=email
SAML_ATTR_NAME=name
SAML_ATTR_FIRST_NAME=firstName
SAML_ATTR_LAST_NAME=lastName
SAML_ATTR_GROUPS=groups
# Accept sign-ins started from the identity provider's dashboard (off: every sign-in starts at Piecewise)
SAML_ALLOW_IDP_INITIATED=false
# Make SAML the only way in: password, OIDC, and trusted-header sign-in are turned off and their sessions ended.
# Turn on only after SAML sign-in has worked once. To get back in, set it to false and restart.
SAML_ENFORCE=false

# SCIM provisioning (Okta → Piecewise) needs no variables: create a bearer token in Admin → Sign-in
# and point Okta at <BASE_URL>/api/scim/v2.

# Trusted-header sign-in when an authenticating proxy (oauth2-proxy, Cloudflare Access, Pomerium) sits in front
AUTH_TRUSTED_HEADER=
AUTH_TRUSTED_NAME_HEADER=
# Shared secret the proxy must send as X-Piecewise-Proxy-Token, so nobody can spoof the header
AUTH_TRUSTED_PROXY_TOKEN=
AUTH_TRUSTED_DEFAULT_ROLE=user

# Sessions and logging
SESSION_DAYS=14
LOG_LEVEL=info
