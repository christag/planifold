# Podman Quadlet unit. Copy to ~/.config/containers/systemd/ (user) or
# /etc/containers/systemd/ (system), then: systemctl --user daemon-reload && systemctl --user start planifold
[Unit]
Description=Planifold — turn a big thought into pieces an AI can build
After=network-online.target
Wants=network-online.target

[Container]
Image=ghcr.io/christag/planifold:latest
ContainerName=planifold
PublishPort=3000:3000
Volume=planifold-data:/data
EnvironmentFile=%h/.config/planifold/planifold.env
AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
